{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "backend/src/**/*.ts",
    "backend/tests/**/*.ts",
    "backend/scripts/**/*.ts"
  ]
}
