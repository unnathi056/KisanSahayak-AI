# Copy this file to .env and replace placeholders with your own values.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
PORT=3001

# Browser-safe settings. The publishable key must be paired with RLS.
# VITE_API_URL sets the backend API origin for production (without /api suffix).
VITE_API_URL=https://kisansahayak-ai-3.onrender.com
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Backend-only settings. Never put the secret key in frontend/.env.
# CORS_ORIGIN specifies allowed frontend origins (comma-separated, or * for all).
CORS_ORIGIN=https://kisansahayak-ai.vercel.app,https://kisan-sahayak-ai-two.vercel.app
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Backend-only notification settings. Automatic verified-scheme scans default to five minutes.
SCHEME_NOTIFICATION_SCAN_INTERVAL_MS=300000

# Optional backend-only token for the on-demand new-scheme job endpoint.
SCHEME_NOTIFICATION_JOB_TOKEN=YOUR_LONG_RANDOM_JOB_TOKEN
